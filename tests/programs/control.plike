function grade(in n: integer): character
begin
    if n >= 90 then grade := 'A'
    elseif n >= 80 then grade := 'B'
    elseif n >= 70 then grade := 'C'
    elseif n >= 60 then grade := 'D'
    elseif n >= 50 then grade := 'E'
    else grade := 'F'
    endif
end grade

procedure steps(in from: integer, in til: integer, in by: integer)
var i, n: integer
begin
    n := 0
    for i := from to til step by do
        n := n + i
    endfor
    print(n)
end steps

procedure main()
var i, j, n: integer
var x: real
begin
    for i := 45 to 95 step 10 do print(grade(i)) endfor
    for i := 6 to 1 step -2 do print(i) endfor
    for i := 1 to 0 do print("never") endfor
    steps(1, 10, 3)
    steps(10, 1, -3)
    for x := 0.0 to 1.0 step 0.5 do print(x) endfor
    for x := 1.0 to 0.0 step -0.5 do print x endfor
    i := 0
    repeat
        i := i + 1
        if i = 2 then
            j := 1
        else if i == 3 then j := 2 else j := 0 endif
        endif
        print("i j", i, j)
    until i >= 3
    begin
        var i: integer
        i := 100
        n := i
    end
    print(i, n)
    while i > 0 do i := i - 1 endwhile
    print(i)
    print()
    print (i + 1) * 2
    print "50% \"quoted\" \\ done"
end main
