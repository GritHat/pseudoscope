// the original sample, with its sloppy "N"
procedure appartiene(A, i, j, elem, n, out: trovato)
    var i, j, elem, n : integer
    var A[1..n][1..n]: array of integer
    var: trovato : logical
    var: a : integer **
    begin
        trovato := .FALSE.
        if(A(i,j) = elem) then
            trovato := .TRUE.
        else 
            if (A(i,j) < elem) then
                if i < N then 
                    appartiene (A, i+1, j, elem,n, trovato)
                else
                    trovato := .FALSE.
                endif
            else 
                if j > 1 then
                    appartiene(A, i, j-1, elem,n,trovato)
                else
                    trovato := .FALSE.
                endif
            endif
        endif
    end
end appartiene

procedure main()
var M: array[3,3] of integer
var i, j: integer
var found: logical
begin
    for i := 1 to 3 do
        for j := 1 to 3 do M[i,j] := i * 10 + j endfor
    endfor
    appartiene(M, 1, 3, 32, 3, found)
    print(found)
    appartiene(M, 1, 3, 24, 3, found)
    print(found)
end main
