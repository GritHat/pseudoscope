procedure MatrixSum (in:m,n,A,B; out:C)
    var m,n,i,j : integer
    var A,B,C : array [1..m, 1..n] of real
    begin
        for i := 1 to m do
            for j := 1 to n do
                C(i,j) := A(i,j) + B(i,j)
            endfor
        endfor
    end
end MatrixSum

procedure ScalarProductMdotV (in:m,n,A,y; out:z)
    var m,n,i,j : integer
    var A : array [1..m, 1..n] of real
    var y: array [1..n] of real
    var z: array [1..m] of real
    begin
        for i := 1 to m do
            z(i) := 0
            for j := 1 to n do
                z(i) := z(i) + A(i,j) * y(j)
            endfor
        endfor
    end
end ScalarProductMdotV

procedure ScalarProductMdotM (in:m,n,p,A,B; out:C)
    var m,n,p,i,j,k : integer; var A : array [1..m, 1..n] of real;
    var B: array [1..n, 1..p] of real; var C: array [1..m, 1..p] of real ;
    begin
        for i := 1 to m do
            for j := 1 to p do
                C(i,j) := 0.
                for k:= 1 to n do
                    C(i,j) := C(i,j) + A(i,k)*B(k,j)
                endfor
            endfor
        endfor
    end
end ScalarProductMdotM

function ScalarProductVdotV (in: x,y,n) : real
    var i, n: integer
    var x,y : array [1..n] of real
    begin
        ScalarProductVdotV := 0.0
        for i:= 1 to n do
            ScalarProductVdotV := ScalarProductVdotV +x(i)*y(i)
        endfor
    end
end ScalarProductVdotV

procedure saxpy (in: a,x,n; in/out: y)
    var i, n : integer
    var a : real
    var x,y : array [1..n] of real
    begin
        for i:= 1 to n do
            y(i) := y(i) +a*x(i)
        endfor
    end
end saxpy

// the sizes come after the matrix, which C does not allow
function trace(A, n): integer
    var A[n, n]: array of integer
    var n, i: integer
    begin
        for i := 1 to n do
            trace := trace + A[i][i]
        endfor
    end
end trace

function row_sum(in n: integer, in r[n]: array of integer): integer
    var i: integer
    begin
        for i := 1 to n do row_sum := row_sum + r[i] endfor
    end
end row_sum

// the size changes inside, the shape must not
function last(in n: integer, in m: integer, in A[n][m]: array of integer): integer
    begin
        m := 1
        last := A[n, 3]
    end
end last

function somma_pari_e_dispari_in_riga(in: n: integer; in A[n][n] : array of integer)  : logical
    var i, j, pari, dispari : integer
    begin
        i := 1
        somma_pari_e_dispari_in_riga := FALSE
        while i <= n and not somma_pari_e_dispari_in_riga do
            pari := 0
            dispari := 0
            for j := 1 to n/2 do
                pari := pari + A[i,j*2]
                dispari := dispari + A[i,j*2-1]
            endfor
            if pari == dispari then
                somma_pari_e_dispari_in_riga := TRUE
            endif
            i := i + 1
        endwhile
    end
end somma_pari_e_dispari_in_riga

procedure main()
    var A, B, C : array[2,3] of real
    var D : array[3][2] of real
    var E : 2d array[2, 2] of real
    var v : array[1..3] of real
    var z : array[2] of real
    var M : array[3,3] of integer
    var Q : array[2,2] of integer
    var i, j : integer
    begin
        for i := 1 to 2 do
            for j := 1 to 3 do
                A(i,j) := i * 10 + j
                B(i,j) := j
                D(j,i) := 1
            endfor
        endfor
        for i := 1 to 3 do
            v(i) := i
            for j := 1 to 3 do M[i,j] := i * j endfor
        endfor
        MatrixSum(2, 3, A, B, C)
        print(C(1,1), C(2,3))
        ScalarProductMdotV(2, 3, A, v, z)
        print(z(1), z(2))
        ScalarProductMdotM(2, 3, 2, A, D, E)
        print(E[1,1], E[2][2])
        print(ScalarProductVdotV(v, v, 3))
        saxpy(2.0, v, 3, v)
        print(v[1], v[2], v[3])
        print(trace(M, 3), row_sum(3, M[2]), last(3, 3, M))
        Q[1,1] := 1; Q[1,2] := 2; Q[2,1] := 5; Q[2,2] := 5
        print(somma_pari_e_dispari_in_riga(2, Q))
    end
endprocedure
