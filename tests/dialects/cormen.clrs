// What the reader of Cormen's pseudocode must take: the numbers before the lines,
// the words of the older editions, arrays from 0 and from 1, r and R.
1  FACTORIAL(n)
2      if n ≤ 1 then return 1
3      else return n · FACTORIAL(n − 1)

5  GCD(a, b)
6      repeat
7          t ← b
8          b ← a mod b
9          a ← t
10     until b == 0
11     return a

COUNTING-SORT(A, n, k)
    let B[1:n] and C[0:k] be new arrays
    for i = 0 to k
        C[i] = 0
    for j = 1 to n
        C[A[j]] = C[A[j]] + 1
    for i = 1 to k
        C[i] = C[i] + C[i - 1]
    for j = n downto 1
        B[C[A[j]]] = A[j]
        C[A[j]] = C[A[j]] - 1       ▷ to handle duplicate values
    for j = 1 to n
        A[j] = B[j]

MATRIX-TRACE(M, n)
    t = 0
    for i = 1 to n by 1
        t = t + M[i, i]
    return t

SIGN(x)
    if x > 0
        return 1
    elseif x == 0
        return 0
    else
        return -1

REVERSE(R, r)
    i = 1
    while i < r
        exchange R[i] with R[r]
        i = i + 1
        r = r - 1

print FACTORIAL(5)
print GCD(48, 18)
let A[1:6] be a new array
A[1] = 2
A[2] = 5
A[3] = 3
A[4] = 0
A[5] = 2
A[6] = 3
COUNTING-SORT(A, 6, 5)
REVERSE(A, 6)
for i = 1 to 6
    print A[i]
let M[1:2, 1:2] be a new table
M[1, 1] = 4
M[1, 2] = 9
M[2, 1] = 9
M[2, 2] = 6
print MATRIX-TRACE(M, 2)
i = j = 7
if i == j and not (i ≠ 7 or FALSE)
    print SIGN(-3), SIGN(0), SIGN(i)
print ⌊7 / 2⌋
