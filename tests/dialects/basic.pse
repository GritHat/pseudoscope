// Cambridge pseudocode
CONSTANT Size = 5
TYPE Student
    DECLARE Name : STRING
    DECLARE Mark : INTEGER
ENDTYPE
DECLARE Numbers : ARRAY[1:5] OF INTEGER
DECLARE Index, Total : INTEGER
DECLARE Average : REAL
DECLARE Best : Student

FUNCTION Max(A : INTEGER, B : INTEGER) RETURNS INTEGER
    IF A > B THEN
        RETURN A
    ELSE
        RETURN B
    ENDIF
ENDFUNCTION

PROCEDURE Swap(BYREF X : INTEGER, Y : INTEGER)
    DECLARE Temp : INTEGER
    Temp ← X
    X <- Y
    Y <- Temp
ENDPROCEDURE

INPUT Best.Name
Best.Mark <- 92
FOR Index <- 1 TO Size
    Numbers[Index] <- Index * 2
    Total <- Total + Numbers[Index]
NEXT Index
Average <- Total / Size
OUTPUT "Average ", Average
CALL Swap(Numbers[1], Numbers[5])
OUTPUT Numbers[1], " ", Numbers[5], " ", Max(3, 8), " ", 17 DIV 5, " ", 17 MOD 5
OUTPUT "Hello " & Best.Name
WHILE Total > 5 DO
    Total <- Total - 10
ENDWHILE
REPEAT
    Total <- Total + 1
UNTIL Total = 3
CASE OF Best.Mark
    0 TO 49 : OUTPUT "Fail"
    50 TO 89 : OUTPUT "Pass"
    OTHERWISE : OUTPUT "Distinction"
ENDCASE
IF Total = 3 AND NOT (Total > 9) THEN
    OUTPUT TRUE
ENDIF
