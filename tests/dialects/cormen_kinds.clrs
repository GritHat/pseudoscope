// Reals and texts in collections, collections of collections, lists in an array.
BUCKET-SORT(A, n)
    let B[0:n − 1] be a new array
    for i = 0 to n − 1
        B[i] = ∅
    for i = 1 to n
        insert A[i] into list B[⌊n · A[i]⌋]
    for i = 0 to n − 1
        sort list B[i] with insertion sort
    k = 0
    for i = 0 to n − 1
        for each x in B[i]
            k = k + 1
            A[k] = x

