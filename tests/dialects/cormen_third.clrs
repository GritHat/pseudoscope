INSERTION-SORT(A)
    for j = 2 to A.length
        key = A[j]
        i = j - 1
        while i > 0 and A[i] > key
            A[i + 1] = A[i]
            i = i - 1
        A[i + 1] = key

SUM-AND-MAX(A)
    s = 0
    y = A[1]
    for each x in A
        s = s + x
        if x > y
            y = x
    return (s, y)

MIN-MAX(A)
    o = A[1]
    no = A[1]
    for i = 2 to A.length
        if A[i] < o
            o = A[i]
        if A[i] > no
            no = A[i]
    return o, no

let B[1:5] be a new array
B[1] = 31
B[2] = 41
B[3] = 59
B[4] = 26
B[5] = 53
INSERTION-SORT(B)
for each y in B
    print y
(total, largest) = SUM-AND-MAX(B)
print total, " ", largest
(si, de) = MIN-MAX(B)
print si, " ", de, " ", B.length
print ⌈7 / 2⌉, " ", ⌊7 / 2⌋, " ", ⌈-7 / 2⌉, " ", ⌊-7 / 2⌋
