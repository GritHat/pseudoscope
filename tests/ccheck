#!/bin/sh
# C compiler used by the tests: warnings are errors, and the compiled programs
# stop at the first invalid access or undefined behaviour.
exec "${TEST_CC:-${CC:-cc}}" -Wall -Wextra -Werror -Wno-unknown-warning-option -Wno-unused-variable -Wno-unused-parameter \
    -Wno-unused-but-set-variable -Wno-unused-but-set-parameter \
    -include "$(dirname "$0")/asan_options.h" -g -fsanitize=address,undefined -fno-sanitize-recover=all "$@"
