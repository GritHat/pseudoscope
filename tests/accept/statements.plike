procedure s(in n: integer, in/out v: array[n] of integer)
var i, j: integer; k: integer
var p: integer*
begin
    i:=1 ; j:=1
    i := j * k
    *p := 3
    p := &v[1]
    k := *p + p[1]
    if (i == j) then i := 2; endif;
    if i = j then
    elseif i != j then i := 1
    else
    endif
    while (i<=n .AND. j < 3)do i := i + 1 endwhile
    for i := n to 1 step -1 do v(i) := v[i] & 0xF0 | 1 endfor
    for i := 1 to n step 2 do endfor
    for j := 1 to 2 step k do endfor
    repeat i := i - 1 until (i < 0) or j == 2
    print i
    print(i, "x", v[1])
    read(i)
    read v[2]
    external(i, 2.5, v, "text", p, v[1] > 2)
    i := external2() + external2()
    external3()
    i := external3()
    var late: real
    late := 3.f
    begin
        begin late := 2 end
    end
    return
end s
