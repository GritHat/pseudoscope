╭─ fib ────────────────────────────────────────────────────────────────────────╮
│     3 function fib(in n: integer): integer                                   │
│     4 begin                                                                  │
│ ▶   5     if n < 2 then                                                      │
│     6         return n                                                       │
│     7     endif                                                              │
│     8     return fib(n - 1) + fib(n - 2)                                     │
│     9 end fib                                                                │
