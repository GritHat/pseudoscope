msgid "'%s' is not in the file: it cannot be called in %s"
msgstr "'%s' no está en el archivo: no se puede llamar en %s"

#: src/back/target.c
msgid "'%s' comes from a library that only works when the program is run here (exec, ui): it is not translated"
msgstr "'%s' viene de una biblioteca que solo funciona cuando el programa se ejecuta aquí (exec, ui): no se traduce"

#: src/back/target.c
msgid "in %s what '%s' changes comes back with its result: call it in a statement of its own"
msgstr "en %s lo que '%s' cambia vuelve junto con su resultado: llámala en una instrucción aparte"

#: src/back/target.c
msgid "%s has no pointers that move from an element to the next"
msgstr "%s no tiene punteros que pasen de un elemento al siguiente"

#: src/back/target.c
msgid "this expects a call between objects, which only the program run here keeps track of (exec, test, ui)"
msgstr "esto espera una llamada entre objetos, de la que solo lleva la cuenta el programa ejecutado aquí (exec, test, ui)"

#: src/back/target.c
msgid "C has no classes that extend others: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "C no tiene clases que extiendan otras: '%s' se puede traducir a C++, Java, TypeScript o Python"

#: src/back/target.c
msgid "Rust has no classes that extend classes: '%s' could only extend an interface (a trait), and '%s' is not"
msgstr "Rust no tiene clases que extiendan clases: '%s' solo podría extender una interfaz (un trait), y '%s' no lo es"

#: src/back/target.c
msgid "in %s a class extends one class only: '%s' has both '%s' and '%s' (C++ and Python allow it; or make one an interface)"
msgstr "en %s una clase extiende una sola clase: '%s' tiene '%s' y '%s' (C++ y Python lo permiten; o convierte una en interfaz)"

#: src/back/target.c
msgid "C has no abstract classes or interfaces: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "C no tiene clases abstractas ni interfaces: '%s' se puede traducir a C++, Java, TypeScript o Python"

