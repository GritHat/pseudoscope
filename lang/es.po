#: src/cli/options.c
msgid "Usage: pseudoscope [COMMAND] [OPTIONS] FILE [OUTPUT]\n\nPseudocode, and designs, brought to life. FILE may be - for the standard input.\n"
msgstr "Uso: pseudoscope [ORDEN] [OPCIONES] ARCHIVO [SALIDA]\n\nPseudocódigo y diseños que cobran vida. ARCHIVO puede ser - para la entrada estándar.\n"

#: src/cli/options.c
msgid "\nCommands:\n  ui          explore programs and watch them run (FILE may be a folder;\n              the default without arguments)\n  translate   write the program in C or in another language (the default command)\n  check       only report errors and warnings\n  build       translate and compile to an executable (C, C++, Rust)\n  run         translate, and execute with the tools of that language\n  exec        execute here, without other tools, checking every access\n  test        run the tests of the program (with --to: translated)\n  tokens      list the tokens\n  ast         print the syntax tree\n"
msgstr "\nÓrdenes:\n  ui          explora los programas y míralos funcionar (ARCHIVO puede ser una carpeta;\n              es la orden que se usa cuando no hay argumentos)\n  translate   escribe el programa en C o en otro lenguaje (la orden por defecto)\n  check       solo informa de errores y avisos\n  build       traduce y compila a un ejecutable (C, C++, Rust)\n  run         traduce, y ejecuta con las herramientas de ese lenguaje\n  exec        ejecuta aquí, sin otras herramientas, comprobando cada acceso\n  test        lanza las pruebas del programa (con --to: traducidas)\n  tokens      enumera los símbolos\n  ast         imprime el árbol sintáctico\n"

#: src/cli/options.c
msgid "\nLanguage of the program:\n      --dialect=NAME        plike, pseint, visualg, portugol, cambridge or cormen\n                            (default: from the extension .pscope .plike .psc .alg .por\n                            .pse .clrs, or from how the file begins)\n  -a, --assignment=STYLE    colon-equals (default) or equals\n  -i, --indexing=BASE       first index of arrays without a range:\n                            one (default) or zero\n  -p, --params=STYLE        where parameter types go: decl, body or mixed (default)\n      --operators=STYLE     standard (and), dotted (.and.) or mixed (default)\n  -m, --mixed-arrays=BOOL   accept a(i) for a[i]: true (default) or false\n"
msgstr "\nLenguaje del programa:\n      --dialect=NOMBRE      plike, pseint, visualg, portugol, cambridge o cormen\n                            (por defecto: según la extensión .pscope .plike .psc .alg .por\n                            .pse .clrs, o según cómo empieza el archivo)\n  -a, --assignment=ESTILO   colon-equals (por defecto) o equals\n  -i, --indexing=BASE       primer índice de los arreglos sin rango:\n                            one (por defecto) o zero\n  -p, --params=ESTILO       dónde van los tipos de los parámetros: decl, body o mixed\n                            (por defecto)\n      --operators=ESTILO    standard (and), dotted (.and.) o mixed (por defecto)\n  -m, --mixed-arrays=BOOL   acepta a(i) en lugar de a[i]: true (por defecto) o false\n"

#: src/cli/options.c
msgid "\nOutput:\n  -t, --to=LANGUAGE         c (default), cpp, java, rust, ts, js or python;\n                            translate also tells from the extension of the output\n  -o, --output=FILE         translate: where to write (default: standard output)\n                            build: executable (default: FILE without extension)\n  -b, --bounds-check        stop with an error on array indices out of bounds\n      --cc=COMMAND          the compiler, or what runs the program, for build and run\n                            (default: $CC or cc, c++, rustc, java, node, python3)\n      --steps=N             exec: stop after N steps\n      --canvas=FILE         exec: save what the program drew, as a PPM picture\n      --dot                 ast: Graphviz format\n"
msgstr "\nSalida:\n  -t, --to=LENGUAJE         c (por defecto), cpp, java, rust, ts, js o python;\n                            translate lo deduce también de la extensión de la salida\n  -o, --output=ARCHIVO      translate: dónde escribir (por defecto: la salida estándar)\n                            build: el ejecutable (por defecto: ARCHIVO sin extensión)\n  -b, --bounds-check        detiene con un error los índices fuera de los límites\n      --cc=ORDEN            el compilador, o lo que ejecuta el programa, para build y run\n                            (por defecto: $CC o cc, c++, rustc, java, node, python3)\n      --steps=N             exec: se detiene tras N pasos\n      --canvas=ARCHIVO      exec: guarda lo que el programa dibujó, como imagen PPM\n      --dot                 ast: formato Graphviz\n"

#: src/cli/options.c
msgid "\nMessages and interface:\n      --lang=LANGUAGE       the language to speak (default: $PSEUDOSCOPE_LANG, or the\n                            language of the system, or English):"
msgstr "\nMensajes e interfaz:\n      --lang=IDIOMA         el idioma en que hablar (por defecto: $PSEUDOSCOPE_LANG, o el\n                            del sistema, o el inglés):"

#: src/cli/options.c
msgid "\n      --color=WHEN          auto (default), always or never\n  -q, --quiet               no warnings\n  -W, --werror              treat warnings as errors\n  -v, --verbose             show the steps\n  -h, --help                show this help\n  -V, --version             show the version\n"
msgstr "\n      --color=CUÁNDO        auto (por defecto), always o never\n  -q, --quiet               sin avisos\n  -W, --werror              trata los avisos como errores\n  -v, --verbose             muestra los pasos\n  -h, --help                muestra esta ayuda\n  -V, --version             muestra la versión\n"

#: src/cli/options.c
msgid "\nExit status: 0 success, 1 errors in the program, 2 wrong usage, 3 files or\ncompiler. run exits with the status of the program.\n"
msgstr "\nEstado de salida: 0 éxito, 1 errores en el programa, 2 uso incorrecto, 3 archivos o\ncompilador. run sale con el estado del programa.\n"

