#: src/cli/options.c
msgid "Usage: pseudoscope [COMMAND] [OPTIONS] FILE [OUTPUT]\n\nPseudocode, and designs, brought to life. FILE may be - for the standard input.\n"
msgstr "Uso: pseudoscope [COMANDO] [OPÇÕES] ARQUIVO [SAÍDA]\n\nPseudocódigo e projetos que ganham vida. ARQUIVO pode ser - para a entrada padrão.\n"

#: src/cli/options.c
msgid "\nCommands:\n  ui          explore programs and watch them run (FILE may be a folder;\n              the default without arguments)\n  translate   write the program in C or in another language (the default command)\n  check       only report errors and warnings\n  build       translate and compile to an executable (C, C++, Rust)\n  run         translate, and execute with the tools of that language\n  exec        execute here, without other tools, checking every access\n  test        run the tests of the program (with --to: translated)\n  tokens      list the tokens\n  ast         print the syntax tree\n"
msgstr "\nComandos:\n  ui          explore os programas e veja-os funcionar (ARQUIVO pode ser uma pasta;\n              é o comando usado quando não há argumentos)\n  translate   escreve o programa em C ou em outra linguagem (o comando padrão)\n  check       só informa erros e avisos\n  build       traduz e compila para um executável (C, C++, Rust)\n  run         traduz, e executa com as ferramentas dessa linguagem\n  exec        executa aqui, sem outras ferramentas, verificando cada acesso\n  test        roda os testes do programa (com --to: traduzidos)\n  tokens      lista os símbolos\n  ast         imprime a árvore sintática\n"

#: src/cli/options.c
msgid "\nLanguage of the program:\n      --dialect=NAME        plike, pseint, visualg, portugol, cambridge or cormen\n                            (default: from the extension .pscope .plike .psc .alg .por\n                            .pse .clrs, or from how the file begins)\n  -a, --assignment=STYLE    colon-equals (default) or equals\n  -i, --indexing=BASE       first index of arrays without a range:\n                            one (default) or zero\n  -p, --params=STYLE        where parameter types go: decl, body or mixed (default)\n      --operators=STYLE     standard (and), dotted (.and.) or mixed (default)\n  -m, --mixed-arrays=BOOL   accept a(i) for a[i]: true (default) or false\n"
msgstr "\nLinguagem do programa:\n      --dialect=NOME        plike, pseint, visualg, portugol, cambridge ou cormen\n                            (padrão: pela extensão .pscope .plike .psc .alg .por\n                            .pse .clrs, ou por como o arquivo começa)\n  -a, --assignment=ESTILO   colon-equals (padrão) ou equals\n  -i, --indexing=BASE       primeiro índice dos vetores sem intervalo:\n                            one (padrão) ou zero\n  -p, --params=ESTILO       onde ficam os tipos dos parâmetros: decl, body ou mixed (padrão)\n      --operators=ESTILO    standard (and), dotted (.and.) ou mixed (padrão)\n  -m, --mixed-arrays=BOOL   aceita a(i) no lugar de a[i]: true (padrão) ou false\n"

#: src/cli/options.c
msgid "\nOutput:\n  -t, --to=LANGUAGE         c (default), cpp, java, rust, ts, js or python;\n                            translate also tells from the extension of the output\n  -o, --output=FILE         translate: where to write (default: standard output)\n                            build: executable (default: FILE without extension)\n  -b, --bounds-check        stop with an error on array indices out of bounds\n      --cc=COMMAND          the compiler, or what runs the program, for build and run\n                            (default: $CC or cc, c++, rustc, java, node, python3)\n      --steps=N             exec: stop after N steps\n      --canvas=FILE         exec: save what the program drew, as a PPM picture\n      --dot                 ast: Graphviz format\n"
msgstr "\nSaída:\n  -t, --to=LINGUAGEM        c (padrão), cpp, java, rust, ts, js ou python;\n                            translate também deduz pela extensão da saída\n  -o, --output=ARQUIVO      translate: onde escrever (padrão: a saída padrão)\n                            build: o executável (padrão: ARQUIVO sem extensão)\n  -b, --bounds-check        interrompe com um erro os índices fora dos limites\n      --cc=COMANDO          o compilador, ou o que executa o programa, para build e run\n                            (padrão: $CC ou cc, c++, rustc, java, node, python3)\n      --steps=N             exec: para depois de N passos\n      --canvas=ARQUIVO      exec: salva o que o programa desenhou, como imagem PPM\n      --dot                 ast: formato Graphviz\n"

#: src/cli/options.c
msgid "\nMessages and interface:\n      --lang=LANGUAGE       the language to speak (default: $PSEUDOSCOPE_LANG, or the\n                            language of the system, or English):"
msgstr "\nMensagens e interface:\n      --lang=IDIOMA         o idioma a falar (padrão: $PSEUDOSCOPE_LANG, ou o do\n                            sistema, ou o inglês):"

#: src/cli/options.c
msgid "\n      --color=WHEN          auto (default), always or never\n  -q, --quiet               no warnings\n  -W, --werror              treat warnings as errors\n  -v, --verbose             show the steps\n  -h, --help                show this help\n  -V, --version             show the version\n"
msgstr "\n      --color=QUANDO        auto (padrão), always ou never\n  -q, --quiet               sem avisos\n  -W, --werror              trata os avisos como erros\n  -v, --verbose             mostra os passos\n  -h, --help                mostra esta ajuda\n  -V, --version             mostra a versão\n"

#: src/cli/options.c
msgid "\nExit status: 0 success, 1 errors in the program, 2 wrong usage, 3 files or\ncompiler. run exits with the status of the program.\n"
msgstr "\nEstado de saída: 0 sucesso, 1 erros no programa, 2 uso incorreto, 3 arquivos ou\ncompilador. run sai com o estado do programa.\n"

