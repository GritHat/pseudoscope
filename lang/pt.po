msgstr "isto espera uma chamada entre objetos, que só o programa executado aqui acompanha (exec, test, ui)"

#: src/back/target.c
msgid "C has no classes that extend others: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "C não tem classes que estendem outras: '%s' pode ser traduzido para C++, Java, TypeScript ou Python"

#: src/back/target.c
msgid "Rust has no classes that extend classes: '%s' could only extend an interface (a trait), and '%s' is not"
msgstr "Rust não tem classes que estendem classes: '%s' só poderia estender uma interface (um trait), e '%s' não é"

#: src/back/target.c
msgid "in %s a class extends one class only: '%s' has both '%s' and '%s' (C++ and Python allow it; or make one an interface)"
msgstr "em %s uma classe estende uma só classe: '%s' tem '%s' e '%s' (C++ e Python permitem; ou torne uma delas interface)"

#: src/back/target.c
msgid "C has no abstract classes or interfaces: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "C não tem classes abstratas nem interfaces: '%s' pode ser traduzido para C++, Java, TypeScript ou Python"

