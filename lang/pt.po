msgid "'%s' comes from a library that only works when the program is run here (exec, ui): it is not translated"
msgstr "'%s' vem de uma biblioteca que só funciona quando o programa é executado aqui (exec, ui): não é traduzido"

#: src/back/target.c
msgid "in %s what '%s' changes comes back with its result: call it in a statement of its own"
msgstr "em %s o que '%s' altera volta junto com o resultado: chame-a em uma instrução própria"

