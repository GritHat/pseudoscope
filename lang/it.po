#: src/back/target.c
msgid "%s has no pointers to plain values: '%s' cannot be translated (C, C++ and Rust have them)"
msgstr "%s non ha puntatori a valori semplici: '%s' non si può tradurre (C, C++ e Rust li hanno)"

#: src/back/target.c
msgid "'%s' is not in the file: it cannot be called in %s"
msgstr "'%s' non è nel file: in %s non si può chiamare"

#: src/back/target.c
msgid "'%s' comes from a library that only works when the program is run here (exec, ui): it is not translated"
msgstr "'%s' viene da una libreria che funziona solo quando il programma è eseguito qui (exec, ui): non viene tradotto"

#: src/back/target.c
msgid "in %s what '%s' changes comes back with its result: call it in a statement of its own"
msgstr "in %s ciò che '%s' modifica torna insieme al risultato: chiamalo in un'istruzione a sé"

#: src/back/target.c
msgid "%s has no pointers that move from an element to the next"
msgstr "%s non ha puntatori che passano da un elemento al successivo"

#: src/back/target.c
msgid "this expects a call between objects, which only the program run here keeps track of (exec, test, ui)"
msgstr "questo aspetta una chiamata tra oggetti, di cui tiene traccia solo l'esecuzione fatta qui (exec, test, ui)"

#: src/back/target.c
msgid "C has no classes that extend others: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "il C non ha classi che ne estendono altre: '%s' si può tradurre in C++, Java, TypeScript o Python"

#: src/back/target.c
msgid "Rust has no classes that extend classes: '%s' could only extend an interface (a trait), and '%s' is not"
msgstr "Rust non ha classi che estendono classi: '%s' potrebbe estendere solo un'interfaccia (un trait), e '%s' non lo è"

#: src/back/target.c
msgid "in %s a class extends one class only: '%s' has both '%s' and '%s' (C++ and Python allow it; or make one an interface)"
msgstr "in %s una classe ne estende una sola: '%s' ha sia '%s' sia '%s' (C++ e Python lo consentono; oppure rendine una un'interfaccia)"

#: src/back/target.c
msgid "C has no abstract classes or interfaces: '%s' can be translated to C++, Java, TypeScript or Python"
msgstr "il C non ha classi astratte né interfacce: '%s' si può tradurre in C++, Java, TypeScript o Python"

