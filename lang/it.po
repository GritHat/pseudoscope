#: src/cli/options.c
msgid "Usage: pseudoscope [COMMAND] [OPTIONS] FILE [OUTPUT]\n\nPseudocode, and designs, brought to life. FILE may be - for the standard input.\n"
msgstr "Uso: pseudoscope [COMANDO] [OPZIONI] FILE [USCITA]\n\nPseudocodice e progetti che prendono vita. FILE può essere - per l'ingresso standard.\n"

#: src/cli/options.c
msgid "\nCommands:\n  ui          explore programs and watch them run (FILE may be a folder;\n              the default without arguments)\n  translate   write the program in C or in another language (the default command)\n  check       only report errors and warnings\n  build       translate and compile to an executable (C, C++, Rust)\n  run         translate, and execute with the tools of that language\n  exec        execute here, without other tools, checking every access\n  test        run the tests of the program (with --to: translated)\n  tokens      list the tokens\n  ast         print the syntax tree\n"
msgstr "\nComandi:\n  ui          esplora i programmi e guardali girare (FILE può essere una cartella;\n              è il comando usato quando non ci sono argomenti)\n  translate   scrive il programma in C o in un altro linguaggio (il comando predefinito)\n  check       segnala soltanto errori e avvisi\n  build       traduce e compila in un eseguibile (C, C++, Rust)\n  run         traduce, ed esegue con gli strumenti di quel linguaggio\n  exec        esegue qui, senza altri strumenti, controllando ogni accesso\n  test        lancia le prove del programma (con --to: tradotte)\n  tokens      elenca i simboli\n  ast         stampa l'albero sintattico\n"

#: src/cli/options.c
msgid "\nLanguage of the program:\n      --dialect=NAME        plike, pseint, visualg, portugol, cambridge or cormen\n                            (default: from the extension .pscope .plike .psc .alg .por\n                            .pse .clrs, or from how the file begins)\n  -a, --assignment=STYLE    colon-equals (default) or equals\n  -i, --indexing=BASE       first index of arrays without a range:\n                            one (default) or zero\n  -p, --params=STYLE        where parameter types go: decl, body or mixed (default)\n      --operators=STYLE     standard (and), dotted (.and.) or mixed (default)\n  -m, --mixed-arrays=BOOL   accept a(i) for a[i]: true (default) or false\n"
msgstr "\nLinguaggio del programma:\n      --dialect=NOME        plike, pseint, visualg, portugol, cambridge o cormen\n                            (predefinito: dall'estensione .pscope .plike .psc .alg .por\n                            .pse .clrs, o da come comincia il file)\n  -a, --assignment=STILE    colon-equals (predefinito) o equals\n  -i, --indexing=BASE       primo indice degli array senza intervallo:\n                            one (predefinito) o zero\n  -p, --params=STILE        dove stanno i tipi dei parametri: decl, body o mixed (predefinito)\n      --operators=STILE     standard (and), dotted (.and.) o mixed (predefinito)\n  -m, --mixed-arrays=BOOL   accetta a(i) per a[i]: true (predefinito) o false\n"

#: src/cli/options.c
msgid "\nOutput:\n  -t, --to=LANGUAGE         c (default), cpp, java, rust, ts, js or python;\n                            translate also tells from the extension of the output\n  -o, --output=FILE         translate: where to write (default: standard output)\n                            build: executable (default: FILE without extension)\n  -b, --bounds-check        stop with an error on array indices out of bounds\n      --cc=COMMAND          the compiler, or what runs the program, for build and run\n                            (default: $CC or cc, c++, rustc, java, node, python3)\n      --steps=N             exec: stop after N steps\n      --canvas=FILE         exec: save what the program drew, as a PPM picture\n      --dot                 ast: Graphviz format\n"
msgstr "\nUscita:\n  -t, --to=LINGUAGGIO       c (predefinito), cpp, java, rust, ts, js o python;\n                            translate lo capisce anche dall'estensione dell'uscita\n  -o, --output=FILE         translate: dove scrivere (predefinito: l'uscita standard)\n                            build: l'eseguibile (predefinito: FILE senza estensione)\n  -b, --bounds-check        ferma con un errore gli indici fuori dai limiti degli array\n      --cc=COMANDO          il compilatore, o ciò che esegue il programma, per build e run\n                            (predefinito: $CC o cc, c++, rustc, java, node, python3)\n      --steps=N             exec: si ferma dopo N passi\n      --canvas=FILE         exec: salva ciò che il programma ha disegnato, come immagine PPM\n      --dot                 ast: formato Graphviz\n"

#: src/cli/options.c
msgid "\nMessages and interface:\n      --lang=LANGUAGE       the language to speak (default: $PSEUDOSCOPE_LANG, or the\n                            language of the system, or English):"
msgstr "\nMessaggi e interfaccia:\n      --lang=LINGUA         la lingua da parlare (predefinita: $PSEUDOSCOPE_LANG, o quella\n                            del sistema, o l'inglese):"

#: src/cli/options.c
msgid "\n      --color=WHEN          auto (default), always or never\n  -q, --quiet               no warnings\n  -W, --werror              treat warnings as errors\n  -v, --verbose             show the steps\n  -h, --help                show this help\n  -V, --version             show the version\n"
msgstr "\n      --color=QUANDO        auto (predefinito), always o never\n  -q, --quiet               nessun avviso\n  -W, --werror              tratta gli avvisi come errori\n  -v, --verbose             mostra i passaggi\n  -h, --help                mostra questo aiuto\n  -V, --version             mostra la versione\n"

#: src/cli/options.c
msgid "\nExit status: 0 success, 1 errors in the program, 2 wrong usage, 3 files or\ncompiler. run exits with the status of the program.\n"
msgstr "\nStato di uscita: 0 riuscito, 1 errori nel programma, 2 uso sbagliato, 3 file o\ncompilatore. run esce con lo stato del programma.\n"

