// PSeInt: las funciones de la biblioteca
Algoritmo Biblioteca
    saludo <- "Hola Mundo"
    Escribir Longitud(saludo), " ", Mayusculas(saludo), " ", Subcadena(saludo, 0, 3)
    Escribir ConvertirATexto(12) + "!", " ", ConvertirANumero("3.5") * 2
    Escribir Redon(2.6), " ", Trunc(2.6), " ", rc(49), " ", abs(-4)
    Escribir PI > 3.14, " ", sen(0), " ", exp(0)
FinAlgoritmo
