function even_odd_sums_in_row(in: n: integer; in A[n][n] : array of integer)  : logical
    var i, j, even, odd : integer
    begin
        i := 1
        even_odd_sums_in_row := FALSE
        while i <= n and not even_odd_sums_in_row do
            even := 0
            odd := 0
            for j := 1 to n/2 do
                even := even + A[i,j*2]
                odd := odd + A[i,j*2-1]
            endfor
            if even == odd then
                even_odd_sums_in_row := TRUE
            endif
            i := i + 1
        endwhile
    end
end even_odd_sums_in_row

procedure BubbleSort (in: n; in/out: A)
    var i, j, n : integer
    var A : array [1..n] of real
    var temp : real
    var sorted: logical
    begin
        sorted:= FALSE
        i:= 1
        while (i<n) AND (NOT sorted) do
            sorted:= TRUE
            for j:= 1 to n-i do
                if A(j)>A(j+1) then
                    temp := A(j)
                    A(j) := A(j+1)
                    A(j+1) := temp
                    sorted:= FALSE
                endif
            endfor
            i:=i+1
        endwhile
    end
end BubbleSort

procedure SelectionSort2 (in: n; in/out: A)
    var i, j, n, p : integer
    var A : array [1..n] of real
    var min, temp: real
    begin
        for i:= 1 to n-1 do
            min:=A(i)
            p:=i
            for j:= i+1 to n do
                if (A(j)<min)then
                    min:=A(j)
                    p:=j
                endif
            endfor
            temp := A(i)
            A(i) := A(p)
            A(p) := temp
        endfor
    end
end SelectionSort2

function ScalarProductVdotV (in: x,y,n) : real
    var i, n: integer
    var x,y : array [1..n] of real
    begin
        ScalarProductVdotV := 0.0
        for i:= 1 to n do
            ScalarProductVdotV := ScalarProductVdotV +x(i)*y(i)
        endfor
    end
end ScalarProductVdotV

procedure saxpy (in: a,x,n; in/out: y)
    var i, n : integer
    var a : real
    var x,y : array [1..n] of real
    begin
        for i:= 1 to n do
            y(i) := y(i) + a*x(i)
        endfor
    end
end saxpy

procedure MatrixSum (in:m,n,A,B; out:C)
    var m,n,i,j : integer
    var A,B,C : array [1..m, 1..n] of real
    begin
        for i := 1 to m do
            for j := 1 to n do
                C(i,j) := A(i,j) + B(i,j)
            endfor
        endfor
    end
end MatrixSum

procedure ScalarProductMdotV (in:m,n,A,y; out:z)
    var m,n,i,j : integer
    var A : array [1..m, 1..n] of real
    var y: array [1..n] of real
    var z: array [1..m] of real
    begin
        for i := 1 to m do
            z(i) := 0
            for j := 1 to n do
                z(i) := z(i) + A(i,j) * y(j)
            endfor
        endfor
    end
end ScalarProductMdotV


procedure ScalarProductMdotM (in:m,n,p,A,B; out:C)
    var m,n,p,i,j,k : integer; var A : array [1..m, 1..n] of real;
    var B: array [1..n, 1..p] of real; var C: array [1..m, 1..p] of real ;
    begin
        for i := 1 to m do
            for j := 1 to p do
                C(i,j) := 0.
                for k:= 1 to n do
                    C(i,j) := C(i,j) + A(i,k)*B(k,j)
                endfor
            endfor
        endfor
    end
end ScalarProductMdotM

logical function OddAndEvenSum(A,N)
    var N, sum_even, sum_odd, i, j : integer
    var A[N,N] : array of integer
    var continua : logical
    begin
        i:=1 ; j:=1
        continua:= .TRUE.
        while (i<=N .AND. continua)do
            sum_even:=0 ; sum_odd:=0
            for j:=1 to N-1 step 2 do
                sum_odd:=sum_odd+A(i,j)
                sum_even:=sum_even+A(i,j+1)
            endfor
            if (sum_even != sum_odd) then
                continua:= .FALSE.
                endif
            i:=i+1
        endwhile
        OddAndEvenSum:= continua
    end
endfunction

function pow(in x:real, in n: integer) : real
    begin
        if n == 0 then
            pow := 1
        else
            pow := x * pow(x, n-1)
        endif
    end
end pow

procedure main()
    var v : array [1..6] of real
    var i : integer
    begin
        for i := 1 to 6 do
            v(i) := (i * 5) mod 7
        endfor
        BubbleSort(6, v)
        for i := 1 to 6 do
            print(v(i))
        endfor
        print(pow(2, 8))
    end
end main
