@startuml
title Shop
abstract class Product {
  +name : string
  +price : real
  +{abstract} tax() : real
}
class Book {
  +author : string
  +tax() : real
}
class Food {
  +expires : date
  +tax() : real
}
class Cart {
  -items : list
  +add(p : Product)
  +total() : real
}
interface Payment {
  +pay(amount : real) : logical
}
class Card
Product <|-- Book
Product <|-- Food
Cart "1" o-- "*" Product : contains
Payment <|.. Card
Cart ..> Payment : uses
@enduml
