// An exercise: the same election, with a mistake. The tests find it: which is it?
// Run "never two leaders in the same term" and look at the Sequence, or at the
// Timing: who voted for whom? (Compare with ../systems/election.plike.)

component Node
    states Follower, Candidate, Leader, Crashed
    var id, term, votes, voted_for: integer
    var deadline: integer

    on start
    begin
        wait_for_leader()
    end start

    // elections start at random times, so that ties are unlikely
    procedure wait_for_leader()
    begin
        cancel Timeout
        deadline := random(10, 30)
        send Timeout to self after deadline
    end wait_for_leader

    procedure step_down(in new_term: integer)
    begin
        term := new_term
        voted_for := 0
        become Follower
    end step_down

    on Timeout when Follower, Candidate
    begin
        term := term + 1
        voted_for := id
        votes := 1
        become Candidate
        send RequestVote(term, id) to all Node
        wait_for_leader()
    end Timeout

    on RequestVote(in t: integer, in candidate: integer) when Follower, Candidate, Leader
    begin
        if t > term then
            step_down(t)
        endif
        if t = term then
            voted_for := candidate
            send Vote(t) to sender
            wait_for_leader()
        endif
    end RequestVote

    on Vote(in t: integer) when Candidate
    begin
        if t = term then
            votes := votes + 1
            if votes > 2 then
                cancel Timeout
                become Leader
                send Beat to self
            endif
        endif
    end Vote

    on Beat when Leader
    begin
        send Heartbeat(term) to all Node
        send Beat to self after 6
    end Beat

    on Heartbeat(in t: integer) when Follower, Candidate, Leader
    begin
        if t >= term then
            if t > term or state = Candidate then
                step_down(t)
            endif
            wait_for_leader()
        endif
    end Heartbeat

    on Crash
    begin
        become Crashed
        cancel Timeout
        cancel Beat
    end Crash
end Node

var nodes: array [1..5] of Node
link nodes <-> nodes delay 1..2
seed 3

procedure name_nodes()
var i: integer
begin
    for i := 1 to 5 do nodes[i].id := i endfor
end name_nodes

function leader(): integer
var i: integer
begin
    leader := 0
    for i := 1 to 5 do
        if nodes[i].state = Leader then leader := i endif
    endfor
end leader

function leaders(): integer
var i: integer
begin
    leaders := 0
    for i := 1 to 5 do
        if nodes[i].state = Leader then leaders := leaders + 1 endif
    endfor
end leaders

test "one leader, and another one when it crashes"
var first: integer
begin
    name_nodes()
    step "somebody gets elected"
    run 60
    check leaders() = 1, "there is exactly one leader"
    first := leader()
    step "the leader crashes"
    send Crash to nodes[first]
    run 80
    step "the others elect a new one"
    check leaders() = 1, "there is exactly one leader again"
    check leader() != first, "and it is another node"
end test

// Leaders of different terms may coexist for a moment; of the same term, never.
function clashes(): integer
var i, j: integer
begin
    clashes := 0
    for i := 1 to 4 do
        for j := i + 1 to 5 do
            if nodes[i].state = Leader and nodes[j].state = Leader then
                if nodes[i].term = nodes[j].term then clashes := clashes + 1 endif
            endif
        endfor
    endfor
end clashes

test "never two leaders in the same term"
var instant, wrong: integer
begin
    name_nodes()
    wrong := 0
    for instant := 1 to 150 do
        run 1
        wrong := wrong + clashes()
    endfor
    check wrong = 0, "at every instant"
end test

procedure main()
begin
    name_nodes()
end main
